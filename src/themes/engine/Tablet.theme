[meta]
name=Tablet
dark=false
skin=modern
chrome=flat

[interaction]
touch=true

[font]
family=Sans Serif
size=12pt

[palette]
background=#fafafb
panel=#ffffff
surface=#ebebed
border=#d5d5d8
text=#2e3436
mutedText=#66666c
accent=#3584e4
accentText=#ffffff

[metrics]
radius=12
lineWidth=1
focusWidth=2
spacing=12
iconSize=24
sliderGroove=6

[controls]
height=36
checkbox=24
checkboxRadius=6
menuPadding=12

[scrollbar]
thickness=16

[tabs]
border=0
indicator=3

[tooltip]
base=#303034
text=#ffffff
